{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:create": "wrangler d1 create programmable-portfolio",
    "db:migrate:local": "wrangler d1 migrations apply programmable-portfolio --local",
    "db:migrate:remote": "wrangler d1 migrations apply programmable-portfolio --remote",
    "db:studio:local": "wrangler d1 execute programmable-portfolio --local --command='SELECT name FROM sqlite_master WHERE type=\"table\";'"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@metaplex-foundation/mpl-token-metadata": "^2.13.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@eslint/js": "^10.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "wrangler": "^4.131.1"
  }
}
