# Devnet RPC (test network — default when the switch is ON)
VITE_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# Optional alias still supported for Devnet
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Mainnet RPC (used when the switch is OFF)
VITE_SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# Backend API base URL
VITE_API_URL=http://localhost:3000
