# Server (legacy — Wrangler uses wrangler.toml [dev] port instead)
PORT=3000

# AI — OpenAI only (required for Autopilot / chat).
# Copy to `.dev.vars` (never commit secrets):
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.6-luna

# On-chain vault / keeper (Devnet)
# PROGRAM_ID=55SD6QmpgygjDqLG3fzcbMvFEdPT4LozjAvPwcJQZXM5
# SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_API_KEY
# KEEPER_SECRET_KEY=  # base58 keeper keypair secret — NEVER a user wallet
# MOCK_USDC_MINT=
# MOCK_NVDAX_MINT=
# MOCK_SOLX_MINT=
# MOCK_STX_MINT=
# SWAP_AUTHORITY_SECRET=  # base58 secret of mint/treasury wallet from setup-devnet-mints.sh

# Set after creating the remote D1 database (npm run db:create)
# Then paste the id into wrangler.toml → database_id
# CLOUDFLARE_ACCOUNT_ID=
